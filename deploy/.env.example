# Production settings for deploy/docker-compose.prod.yml.
# Copy to deploy/.env on the server — or better, run ./generate-env.sh,
# which creates it with strong random secrets filled in.
# NEVER commit deploy/.env (it's in .gitignore).

# Your domain, without https:// or www. Four hostnames are used:
#   example.com (website), app.example.com (dashboard),
#   admin.example.com (operator console), api.example.com (API)
DOMAIN=example.com

# --- Secrets (generate-env.sh fills these with random values) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
SESSION_SECRET=

# --- GitHub App (required: repo connection + sign-in) ---
# Webhook URL to set in the GitHub App:  https://api.<DOMAIN>/github/webhook
# OAuth callback URL:                     https://api.<DOMAIN>/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI (required for analysis, chat, reports) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_PROVIDER=anthropic

# --- Email (required for invites and password resets) ---
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
OPERATOR_ALERT_EMAIL=

# --- Free trial ---
TRIAL_DAYS=30

# --- Payments (optional until you're ready to charge) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# --- Optional ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SENTRY_DSN=
