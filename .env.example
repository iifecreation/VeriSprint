# Copy to .env and fill in. Local dev defaults assume `docker-compose up` for
# Postgres + Redis.

# --- App ---
# Ports 58000/53000, not 8000/3000 — this repo assumes other local projects
# on your machine may already hold the usual ports. Change freely if not.
ENV=development
API_BASE_URL=http://localhost:58000
WEB_BASE_URL=http://localhost:53000
# Two more frontend deploys — CORS-allowed origins (see app/main.py).
ADMIN_BASE_URL=http://localhost:53200
MARKETING_BASE_URL=http://localhost:53100
SESSION_SECRET=dev-secret-change-me

# --- Auth (spec Section 6) — JWT access/refresh tokens ---
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-jwt-secret-change-me
JWT_ISSUER=verisprint
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Where GitHub OAuth/SSO callbacks hand tokens to the SPA (URL fragment route).
FRONTEND_AUTH_CALLBACK_PATH=/auth/callback

# --- Postgres (structured data) ---
# Port 55432, not the default 5432 — see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://verisprint:verisprint@localhost:55432/verisprint

# --- Vector DB (pgvector by default — same instance as above; point at a
#     managed vector DB instead if you outgrow it) ---
VECTOR_DB_URL=postgresql+asyncpg://verisprint:verisprint@localhost:55432/verisprint

# --- Queue (Redis-backed arq) ---
# Port 56379, not the default 6379 — see docker-compose.yml.
REDIS_URL=redis://localhost:56379/0

# --- GitHub App ---
# Create at https://github.com/settings/apps/new — read-only permissions only:
# Repository permissions -> Contents (read), Metadata (read), Pull requests
# (read). Subscribe to webhook events: push, pull_request, installation,
# installation_repositories — the last two are required, not optional: the
# `installation` event is what actually creates the Workspace row on install
# (see app/routers/github_app.py::_handle_installation_created), and
# `installation_repositories` is what adds/removes Repo rows when the
# installation's repo access changes. Without both, "Connect a repo" never
# results in a Workspace existing, even though the webhook URL is reachable.
GITHUB_APP_ID=
# The App's URL slug, shown as "Public link" on its GitHub settings page —
# e.g. for github.com/apps/verisprint-app/installations/new the slug is
# verisprint-app. NOT the same as GITHUB_APP_ID above (that's the numeric ID
# used to sign JWTs for the GitHub API) — both are required, for different
# things. Without this set, "Connect a repo" on the marketing site sends
# people to /login instead of a broken github.com URL.
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Email digests (optional) ---
RESEND_API_KEY=
# Where a real new contact-form submission notifies (best-effort — the
# submission is saved regardless, see routers/contact.py). Defaults to
# hello@verisprint.dev in code if left unset.
CONTACT_NOTIFY_EMAIL=
# Where a real production error/critical ErrorEvent emails the operator in
# real time (see app/observability.py) — throttled per error source so a
# repeating failure sends one email per 15 minutes, not one per occurrence.
# Falls back to CONTACT_NOTIFY_EMAIL if left unset. Needs RESEND_API_KEY
# configured too, or alerts silently no-op (the dashboard's Errors panel
# still records everything either way).
OPERATOR_ALERT_EMAIL=

# --- Ticket sync (optional for MVP demo — manual ticket entry works without it) ---
JIRA_API_TOKEN=
JIRA_BASE_URL=
LINEAR_API_KEY=

# --- Object storage (raw diffs). Leave OBJECT_STORAGE_BUCKET unset locally
#     and the API falls back to writing diffs under apps/api/.local_object_storage ---
OBJECT_STORAGE_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:58000

# --- Public marketing site (apps/marketing/.env.local) — separate app ---
NEXT_PUBLIC_APP_URL=http://localhost:53000
# NEXT_PUBLIC_API_BASE_URL is the same var as above, also needed here

# --- LLM provider option: self-hosted / on-prem (spec Section 5.11) ---
# Leave LLM_PROVIDER=anthropic (default) to use the Claude API directly, or
# point ANTHROPIC_BASE_URL at a private VPC/proxy endpoint for that same API.
# Set LLM_PROVIDER=openai_compatible to route every LLM call to a self-hosted
# server instead (vLLM, Ollama, LM Studio, text-generation-webui, ...).
LLM_PROVIDER=anthropic
ANTHROPIC_BASE_URL=
ON_PREM_LLM_BASE_URL=
ON_PREM_LLM_MODEL=
ON_PREM_LLM_API_KEY=

# --- SSO (Enterprise tier, Section 5.11) — generic OIDC. Leave unset to keep
#     GitHub OAuth as the only login path. ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# --- Observability (spec Section 7) ---
# Optional — the Super-Admin Dashboard's error/metrics panels are backed by
# the DB (ErrorEvent/SystemMetric) regardless of whether this is set. Sentry
# adds full stack traces + alerting on top when a DSN is configured.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Billing (spec Section 7) — Stripe Checkout + Customer Portal + webhooks ---
# Self-serve tiers only; create one recurring Price per tier in the Stripe
# Dashboard and paste its price ID (price_...) below. ENTERPRISE is
# sales-assisted, provisioned manually via the Super-Admin Dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TEAM=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_AGENCY=
