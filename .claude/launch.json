{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 58000"],
      "port": 58000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd apps/web && npm run dev"],
      "port": 53000
    }
  ]
}
